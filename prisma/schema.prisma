generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   BigInt                @id @default(autoincrement())
  name                 String                @db.VarChar(255)
  email                String                @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt      DateTime?             @map("email_verified_at") @db.Timestamp(0)
  password             String                @db.VarChar(255)
  rememberToken        String?               @map("remember_token") @db.VarChar(100)
  createdAt            DateTime?             @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamp(0)
  role                 String                @default("staff") @db.VarChar(255)
  departmentId         BigInt?               @map("department_id")
  avatar               String?               @db.VarChar(255)
  activity_logs        activity_logs[]
  notifications        Notification[]
  createdEnhancements  ProjectEnhancement[]  @relation("EnhancementCreator")
  createdTimelines     ProjectTimeline[]     @relation("TimelineCreator")
  createdProjects      Project[]             @relation("ProjectCreator")
  assignedRequirements TimelineRequirement[] @relation("RequirementAssignee")
  createdRequirements  TimelineRequirement[] @relation("RequirementCreator")
  department           Department?           @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "users_department_id_foreign")

  @@map("users")
}

model Department {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  users       User[]

  @@map("departments")
}

model Project {
  id                 BigInt               @id @default(autoincrement())
  title              String               @db.VarChar(255)
  description        String?
  startDate          DateTime             @map("start_date") @db.Date
  endDate            DateTime             @map("end_date") @db.Date
  priority           String               @default("sedang") @db.VarChar(255)
  progressPercentage Int                  @default(0) @map("progress_percentage") @db.SmallInt
  status             String               @default("pending") @db.VarChar(255)
  createdBy          BigInt               @map("created_by")
  createdAt          DateTime?            @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?            @updatedAt @map("updated_at") @db.Timestamp(0)
  pic                String?              @db.VarChar(255)
  enhancements       ProjectEnhancement[]
  timelines          ProjectTimeline[]
  creator            User                 @relation("ProjectCreator", fields: [createdBy], references: [id], onUpdate: NoAction, map: "projects_created_by_foreign")

  @@map("projects")
}

model ProjectEnhancement {
  id                 BigInt            @id @default(autoincrement())
  projectId          BigInt            @map("project_id")
  title              String            @db.VarChar(255)
  description        String?
  status             String            @default("pending") @db.VarChar(255)
  progressPercentage Int               @default(0) @map("progress_percentage")
  createdBy          BigInt?           @map("created_by")
  pic                String?           @db.VarChar(255)
  createdAt          DateTime?         @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?         @updatedAt @map("updated_at") @db.Timestamp(0)
  creator            User?             @relation("EnhancementCreator", fields: [createdBy], references: [id], onUpdate: NoAction, map: "project_enhancements_created_by_foreign")
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_enhancements_project_id_foreign")
  timelines          ProjectTimeline[]

  @@map("project_enhancements")
}

model ProjectTimeline {
  id                 BigInt                @id @default(autoincrement())
  projectId          BigInt                @map("project_id")
  title              String                @db.VarChar(255)
  description        String?
  startDate          DateTime              @map("start_date") @db.Date
  endDate            DateTime              @map("end_date") @db.Date
  durationDays       Int                   @default(0) @map("duration_days") @db.SmallInt
  priority           String                @default("sedang") @db.VarChar(255)
  progressPercentage Int                   @default(0) @map("progress_percentage") @db.SmallInt
  status             String                @default("pending") @db.VarChar(255)
  createdBy          BigInt                @map("created_by")
  createdAt          DateTime?             @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?             @updatedAt @map("updated_at") @db.Timestamp(0)
  pic                String?               @db.VarChar(255)
  enhancementId      BigInt?               @map("enhancement_id")
  creator            User                  @relation("TimelineCreator", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_timelines_created_by_foreign")
  enhancement        ProjectEnhancement?   @relation(fields: [enhancementId], references: [id], onUpdate: NoAction, map: "project_timelines_enhancement_id_foreign")
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_timelines_project_id_foreign")
  requirements       TimelineRequirement[]

  @@index([projectId, status], map: "pt_project_status_idx")
  @@map("project_timelines")
}

model TimelineRequirement {
  id                 BigInt          @id @default(autoincrement())
  timelineId         BigInt          @map("timeline_id")
  title              String          @db.VarChar(255)
  description        String?
  assignedTo         BigInt?         @map("assigned_to")
  startDate          DateTime?       @map("start_date") @db.Date
  endDate            DateTime?       @map("end_date") @db.Date
  dueDate            DateTime        @map("due_date") @db.Date
  durationDays       Int             @default(0) @map("duration_days") @db.SmallInt
  progressPercentage Int             @default(0) @map("progress_percentage") @db.SmallInt
  priority           String          @default("sedang") @db.VarChar(255)
  status             String          @default("pending") @db.VarChar(255)
  isCompleted        Boolean         @default(false) @map("is_completed")
  completedAt        DateTime?       @map("completed_at") @db.Timestamp(0)
  createdBy          BigInt          @map("created_by")
  createdAt          DateTime?       @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?       @updatedAt @map("updated_at") @db.Timestamp(0)
  pic                String?         @db.VarChar(255)
  assignedUser       User?           @relation("RequirementAssignee", fields: [assignedTo], references: [id], onUpdate: NoAction, map: "timeline_requirements_assigned_to_foreign")
  creator            User            @relation("RequirementCreator", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timeline_requirements_created_by_foreign")
  timeline           ProjectTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timeline_requirements_timeline_id_foreign")

  @@index([dueDate], map: "timeline_requirements_due_date_index")
  @@index([isCompleted], map: "timeline_requirements_is_completed_index")
  @@index([status], map: "timeline_requirements_status_index")
  @@index([assignedTo, isCompleted], map: "tr_assigned_completed_idx")
  @@index([dueDate, isCompleted], map: "tr_due_completed_idx")
  @@index([timelineId, status], map: "tr_timeline_status_idx")
  @@map("timeline_requirements")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  title     String    @db.VarChar(255)
  message   String
  type      String    @default("reminder") @db.VarChar(255)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_foreign")

  @@index([userId, isRead], map: "notif_user_read_idx")
  @@map("notifications")
}

model activity_logs {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt?
  action        String    @db.VarChar(255)
  description   String?
  loggable_type String?   @db.VarChar(255)
  loggable_id   BigInt?
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  users         User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "activity_logs_user_id_foreign")

  @@index([loggable_type, loggable_id], map: "activity_logs_loggable_type_loggable_id_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}
