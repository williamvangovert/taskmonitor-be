# ---- Server ----
PORT=8000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated).
# Vite dev server defaults to 5173. Add your production frontend URL here too.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (PostgreSQL / Neon) ----
# Use the POOLED connection string from the Neon dashboard, and keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- Auth (JWT) ----
# Replace with a long, random secret in every real environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
